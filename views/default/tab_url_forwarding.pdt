<?php /** @var View $this **/ ?>

<?php if (!empty($forwarding_records)) { ?>
<div class="table-responsive mb-3">
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Opensrs.tab_url_forwarding.field_subdomain'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_url_forwarding.field_destination'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_url_forwarding.field_redirect_type'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_url_forwarding.field_options'); ?></span></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($forwarding_records as $record) { ?>
            <tr>
                <td><?php echo $this->Html->safe($record['subdomain'] ?? '@'); ?></td>
                <td><?php echo $this->Html->safe($record['ip_address'] ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record['type'] ?? ''); ?></td>
                <td>
                    <?php
                    $this->Form->create(null, ['class' => 'd-inline']);
                    $this->Form->fieldHidden('action', 'delete_forwarding');
                    $this->Form->fieldHidden('record_index', $record['record_index'] ?? '');
                    ?>
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="<?php $this->_(
                        'Opensrs.tab_url_forwarding.field_delete',
                    ); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                    <?php $this->Form->end(); ?>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
</div>
<?php } else { ?>
<div class="card-body text-center text-muted py-5 mb-3">
    <i class="bi bi-signpost-split" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('Opensrs.tab_url_forwarding.no_records'); ?></p>
</div>
<?php } ?>

<h5><?php $this->_('Opensrs.tab_url_forwarding.add_record'); ?></h5>
<?php $this->Form->create(); ?>
<?php $this->Form->fieldHidden('action', 'set_forwarding'); ?>
<div class="mb-3">
    <?php
    $this->Form->label(
        $this->_('Opensrs.tab_url_forwarding.field_subdomain', true),
        'subdomain',
        ['class' => 'form-label'],
    );
    $this->Form->fieldText(
        'subdomain',
        ($vars->subdomain ?? '@'),
        ['id' => 'subdomain', 'class' => 'form-control'],
    );
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label(
        $this->_('Opensrs.tab_url_forwarding.field_destination', true),
        'destination',
        ['class' => 'form-label'],
    );
    $this->Form->fieldText(
        'destination',
        ($vars->destination ?? null),
        ['id' => 'destination', 'class' => 'form-control'],
    );
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label(
        $this->_('Opensrs.tab_url_forwarding.field_redirect_type', true),
        'redirect_type',
        ['class' => 'form-label'],
    );
    $this->Form->fieldSelect(
        'redirect_type',
        ($redirect_types ?? []),
        ($vars->redirect_type ?? '301'),
        ['id' => 'redirect_type', 'class' => 'form-select'],
    );
    ?>
</div>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Opensrs.tab_url_forwarding.field_add', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>
<?php $this->Form->end(); ?>
