<?php /** @var View $this **/ ?>

<?php if (!empty($records)) { ?>
<div class="table-responsive mb-3">
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Opensrs.tab_dns.field_type'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_dns.field_subdomain'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_dns.field_ip_address'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_dns.field_priority'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_dns.field_ttl'); ?></span></th>
                <th><span><?php $this->_('Opensrs.tab_dns.field_options'); ?></span></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($records as $record) { ?>
            <tr>
                <td><?php echo $this->Html->safe($record['record_type'] ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record['subdomain'] ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record['ip_address'] ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record['priority'] ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record['ttl'] ?? ''); ?></td>
                <td>
                    <?php
                    $this->Form->create(null, ['class' => 'd-inline']);
                    $this->Form->fieldHidden('action', 'delete_record');
                    $this->Form->fieldHidden('record_type', $record['record_type'] ?? '');
                    $this->Form->fieldHidden('record_index', $record['record_index'] ?? '');
                    ?>
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="<?php $this->_(
                        'Opensrs.tab_dns.field_delete',
                    ); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                    <?php $this->Form->end(); ?>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
</div>
<?php } else { ?>
<div class="card-body text-center text-muted py-5 mb-3">
    <i class="bi bi-globe" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('Opensrs.tab_dns.no_records'); ?></p>
</div>
<?php } ?>

<h5><?php $this->_('Opensrs.tab_dns.add_record'); ?></h5>
<?php $this->Form->create(); ?>
<?php $this->Form->fieldHidden('action', 'add_record'); ?>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Opensrs.tab_dns.field_type', true), 'type', ['class' => 'form-label']);
    $this->Form->fieldSelect(
        'type',
        ($record_types ?? []),
        ($vars->type ?? 'A'),
        ['id' => 'type', 'class' => 'form-select'],
    );
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Opensrs.tab_dns.field_subdomain', true), 'subdomain', ['class' => 'form-label']);
    $this->Form->fieldText(
        'subdomain',
        ($vars->subdomain ?? null),
        ['id' => 'subdomain', 'class' => 'form-control'],
    );
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Opensrs.tab_dns.field_ip_address', true), 'ip_address', ['class' => 'form-label']);
    $this->Form->fieldText(
        'ip_address',
        ($vars->ip_address ?? null),
        ['id' => 'ip_address', 'class' => 'form-control'],
    );
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Opensrs.tab_dns.field_priority', true), 'priority', ['class' => 'form-label']);
    $this->Form->fieldText(
        'priority',
        ($vars->priority ?? null),
        ['id' => 'priority', 'class' => 'form-control'],
    );
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Opensrs.tab_dns.field_ttl', true), 'ttl', ['class' => 'form-label']);
    $this->Form->fieldText('ttl', ($vars->ttl ?? '3600'), ['id' => 'ttl', 'class' => 'form-control']);
    ?>
</div>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Opensrs.tab_dns.field_add', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>
<?php $this->Form->end(); ?>

<hr>

<?php $this->Form->create(null, ['class' => 'd-inline']); ?>
<?php $this->Form->fieldHidden('action', 'reset_zone'); ?>
<?php $this->Form->fieldSubmit('reset', $this->_('Opensrs.tab_dns.field_reset', true), [
    'class' => 'btn btn-outline-danger',
]); ?>
<?php $this->Form->end(); ?>
